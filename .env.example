PORT=5000

# Google Gemini AI SDK Key
GEMINI_API_KEY=your_gemini_api_key_here

# SAP Gateway HTTPS OData v2 Integration Parameters
SAP_ODATA_URL=https://merida.cob.csuchico.edu:8038/sap/opu/odata/sap/ZPLUSE_SRV
SAP_CLIENT=105
SAP_USER=your_sap_user
SAP_PASS=your_sap_password
SAP_PASSWD=your_sap_password
SAP_ALLOW_SELF_SIGNED=true

# Agentic AI Resilience Settings (gemini-2.5-flash Primary)
GEMINI_MODEL=gemini-2.5-flash
SIMULATION_MODE=false
FALLBACK_MODE_AUTO=true

# Security & Email Alerts
JWT_SECRET=your_jwt_secret_here
EMAIL_USER=your_email_user@example.com
EMAIL_PASS=your_email_app_password
